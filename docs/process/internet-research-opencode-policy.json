{
  "policy_name": "internet-research-safe-local-evidence-direct-parallel-search",
  "purpose": "Tracked, non-secret OpenCode permission template for restricted internet-research workers that may query local Leaders DB evidence and discover cited web sources through the approved direct Parallel Search CLI wrapper.",
  "default_posture": "deny",
  "allowed_local_bash": {
    "*": "deny",
    "leaders-db research local-evidence --*": "allow",
    "leaders-db research parallel-search --*": "allow"
  },
  "allowed_web_path": {
    "discovery": "leaders-db research parallel-search",
    "known_url_fetch": "webfetch",
    "fallback_known_url_fetch": "webfetch"
  },
  "obsolete_mcp_tools_not_approved": [
    "parallel_search_web_search",
    "parallel_search_web_fetch"
  ],
  "required_parallel_api": {
    "endpoint": "https://api.parallel.ai/v1/search",
    "api_key_environment_variable": "PARALLEL_API_KEY",
    "local_secret_file": ".env",
    "approved_cli": "leaders-db research parallel-search --*"
  },
  "run_profiling_required": {
    "enabled": true,
    "minimum_fields": [
      "started_at_utc",
      "completed_at_utc",
      "elapsed_seconds",
      "local_artifacts_read_count",
      "local_evidence_cli_calls_attempted",
      "parallel_search_calls_attempted",
      "parallel_search_calls_succeeded",
      "parallel_search_calls_failed",
      "url_fetch_calls_attempted",
      "parallel_usage_reported_by_tool",
      "token_counts_reported_by_tool",
      "estimated_excerpt_characters",
      "slow_steps",
      "fallbacks_or_blockers"
    ],
    "unknown_value_policy": "Use null or 'unknown_not_exposed_by_tool'; do not invent counts."
  },
  "source_confidence_registry": {
    "path": "docs/methodology/source-confidence-registry.json",
    "required": true,
    "required_citation_profile_fields": [
      "source_confidence",
      "source_confidence_reason",
      "source_type",
      "final_evidence_use"
    ],
    "source_diversity_rule": "Do not use low or very_low confidence sources as sole support for score-bearing claims. Rate newly discovered sources before relying on them."
  },
  "restricted_worker_permission_contract": {
    "*": "deny",
    "bash": {
